{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@lamp/config/oxlint.json"],
  "env": {
    "node": true
  },
  "rules": {
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/instrument.js"]
      }
    ]
  }
}
