{
  "name": "@lamp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lamp API: NestJS 12 (ESM), auth and sync",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "cli": "nest build && node dist/cli.js",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src test prisma",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@lamp/domain": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@zxcvbn-ts/language-common": "catalog:",
    "nest-commander": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "resend": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lamp/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/mailparser": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "mailparser": "catalog:",
    "oxlint": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
