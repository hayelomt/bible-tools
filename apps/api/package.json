{
  "name": "@lamp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lamp API: NestJS 12 (ESM), auth and sync",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
