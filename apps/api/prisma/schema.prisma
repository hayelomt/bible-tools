// Lamp data model (TECH-DESIGN §5). Conventions:
// - ids are UUIDv7. Synced rows get theirs from the client (offline creates); the default is
//   for rows the server creates itself and for the seed.
// - Synced rows carry userId, createdAt, updatedAt (client time, adjusted, §6.5), rev (server
//   assigned, §6.3) and deletedAt (tombstone). updatedAt is not @updatedAt: the client sets it.
// - Enum-like columns are text with check constraints, and Tag/SectionTag/LessonTag uniqueness
//   is a partial index (WHERE deleted_at IS NULL). Both live in raw SQL in the migrations, along
//   with the citext extension and the "C" collation on section.order_key.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // The build (SWC) keeps import specifiers as written, so they must name the emitted .js
  // files. Without this, Prisma picks .ts because tsconfig allows .ts imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// role: user | admin
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique @db.Citext
  passwordHash      String    @map("password_hash")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  role              String    @default("user")
  syncRev           BigInt    @default(0) @map("sync_rev")
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(3)
  // The weekly email of group activity (M13-12): off until turned on; when it last went out.
  groupDigest       Boolean   @default(false) @map("group_digest")
  groupDigestSentAt DateTime? @map("group_digest_sent_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  emailTokens     EmailToken[]
  settings        UserSettings?
  series          Series[]
  lessons         Lesson[]
  sections        Section[]
  tags            Tag[]
  sectionTags     SectionTag[]
  lessonTags      LessonTag[]
  takeaways       Takeaway[]
  questions       Question[]
  highlights      Highlight[]
  memoryItems     MemoryItem[]
  inboxItems      InboxItem[]
  inboxItemTags   InboxItemTag[]
  questionEntries QuestionEntry[]
  templates       Template[]
  passageVisits   PassageVisit[]
  dismissals      ResurfaceDismissal[]
  citations       Citation[]
  links           Link[]
  syncChanges     SyncChange[]
  devices         Device[]
  shareLinks      ShareLink[]
  groupMembers    GroupMember[]
  comments        Comment[]
  groupVisits     GroupVisit[]

  @@map("user")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // SHA-256 of the cookie token, hex
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  // The device this session syncs from, set by its first push or pull. Signing a device out
  // deletes its sessions (§6.6). No foreign key, like sync_change.device_id.
  deviceId   String?  @map("device_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@map("session")
}

// A read-only share link (F34, §17.10), server only like Session: made, listed and revoked
// through its own endpoints, never synced. targetType: lesson | series | compile | handout.
// targetId is the lesson or series (the handout's lesson), with no foreign key, like link.target_id;
// a compile view has its scope in passage instead. The token is HMAC(SHARE_LINK_SECRET, id), so the
// owner can be shown it again; only its SHA-256 is stored, to find the link by. A frozen link
// (live = false: a handout, or a compile view as it was) renders snapshot; a live one, the rows.
model ShareLink {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  targetType   String    @map("target_type")
  targetId     String?   @map("target_id") @db.Uuid
  passage      Json?
  // SHA-256 of the token, hex
  tokenHash    String    @unique @map("token_hash")
  live         Boolean
  snapshot     Json?
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("share_link")
}

// Groups (F35, §17.12), server only: written by the group endpoints, never pushed. Members read
// each other through group_feed, at the group's own revision (sync_rev). The invite token is
// HMAC(SHARE_LINK_SECRET, "invite:<id>:<inviteVersion>"); only its SHA-256 is stored. A group is
// deleted when its last member leaves.
model Group {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  syncRev         BigInt   @default(0) @map("sync_rev")
  inviteVersion   Int      @default(1) @map("invite_version")
  inviteTokenHash String   @unique @map("invite_token_hash")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members GroupMember[]
  series  GroupSeries[]
  feed    GroupFeed[]

  @@map("group")
}

// role: owner | member; one owner per group (a partial unique index). Deleted on leaving.
model GroupMember {
  id          String   @id @default(uuid(7)) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  displayName String   @map("display_name")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

// A series shared into a group: in one group at most, added by the group's owner, its own.
model GroupSeries {
  id        String   @id @default(uuid(7)) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  seriesId  String   @unique @map("series_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_series")
}

// What a group's members have seen, at the group rev it last changed; gone once they must drop
// it. An index, not a copy: the rows are read from their tables when pulled. entity: group |
// member | series | lesson | section | question | comment.
model GroupFeed {
  groupId  String   @map("group_id") @db.Uuid
  entity   String
  entityId String   @map("entity_id") @db.Uuid
  rev      BigInt
  gone     Boolean  @default(false)
  // When the row first reached the group (M13-11, M13-12): what's new to a member, and to the
  // weekly email, is what was added since.
  addedRev BigInt   @map("added_rev")
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, entity, entityId])
  @@index([groupId, rev])
  @@index([entity, entityId])
  @@index([groupId, addedAt])
  @@map("group_feed")
}

// A comment on a group section (F35, M13-09, §17.12), synced like the author's other rows. Its
// section may be another member's, and its group is a group, so neither is a foreign key.
// body: plain text and verse chips (domain commentBodySchema)
model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sectionId String    @map("section_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  body      Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([sectionId])
  @@index([groupId])
  @@map("comment")
}

// How far a member has read a group's activity (M13-11): their own synced row, one per group (its
// id derived from the pair). No foreign key to the group: a visit outlives leaving, as a lesson does.
model GroupVisit {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  seenRev   BigInt    @map("seen_rev")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@map("group_visit")
}

// kind: verify | reset
model EmailToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_token")
}

// colorMode: light | dark | system
model UserSettings {
  userId             String   @id @map("user_id") @db.Uuid
  colorMode          String   @default("system") @map("color_mode")
  defaultTranslation String   @default("BSB") @map("default_translation")
  reviewWindowDays   Int      @default(14) @map("review_window_days")
  autoPreviewVerses  Boolean  @default(true) @map("auto_preview_verses")
  pasteChips         Boolean  @default(true) @map("paste_chips")
  // The "Open in…" target keys shown, in order: blueletterbible | youversion | biblehub | logos
  openInTargets      Json     @default("[\"blueletterbible\", \"youversion\", \"biblehub\", \"logos\"]") @map("open_in_targets")
  // The template each kind of new lesson starts with: { sermon, personal, group }, each null, a
  // built-in's key (builtin:soap) or a template's id (§17.6)
  defaultTemplates   Json     @default("{\"sermon\": null, \"personal\": null, \"group\": null}") @map("default_templates")
  // Which resurfacing rules feed the review queue (F30): { yearAgo, repeatedVerse, staleQuestion }
  resurfacing        Json     @default("{\"yearAgo\": true, \"repeatedVerse\": true, \"staleQuestion\": true}")
  // The last quarter a digest was drafted for (F32), 2026-Q3: once per account
  lastDigestQuarter  String?  @map("last_digest_quarter")
  rev                BigInt   @default(0)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// kind: sermon_series | book_study | custom
model Series {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String    @default("")
  kind        String    @default("custom")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev         BigInt    @default(0)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  groups  GroupSeries[]

  @@index([userId, rev])
  @@map("series")
}

// source: sermon | personal | group
// mainPassages: VerseRef[] (domain schema)
model Lesson {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  seriesId        String?   @map("series_id") @db.Uuid
  title           String
  date            DateTime  @db.Date
  // sermon | personal | group; `source` until M10 (§17.7)
  kind            String    @default("sermon")
  // Left the wire format in M10 for `kind`; stays, unwritten, for one release so a rollback still
  // works, and the next release drops it.
  source          String    @default("sermon")
  speaker         String?
  church          String?
  mainPassages    Json      @default("[]") @map("main_passages")
  // The source (F28, §17.7): sermon | book | podcast | other, a title, an author, an http(s) link,
  // and when the recording starts, which section times count from
  sourceType      String?   @map("source_type")
  sourceTitle     String?   @map("source_title")
  sourceAuthor    String?   @map("source_author")
  sourceUrl       String?   @map("source_url")
  sourceStartedAt DateTime? @map("source_started_at") @db.Timestamptz(3)
  // The group lesson this is the user's own lesson for (decision 99, §17.12): another user's, so
  // no foreign key. Set at creation, never changed.
  groupLessonId   String?   @map("group_lesson_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev             BigInt    @default(0)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  series          Series?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  sections        Section[]
  tags            LessonTag[]
  takeaways       Takeaway[]
  questions       Question[]
  citations       Citation[]
  questionEntries QuestionEntry[]
  links           Link[]

  @@index([userId, rev])
  @@index([seriesId])
  @@index([groupLessonId])
  @@map("lesson")
}

// body: restricted ProseMirror JSON (domain bodySchema)
// orderKey: fractional index key among siblings; column collation is "C" (byte order)
model Section {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  lessonId          String    @map("lesson_id") @db.Uuid
  parentId          String?   @map("parent_id") @db.Uuid
  orderKey          String    @map("order_key")
  body              Json
  conflictOf        String?   @map("conflict_of") @db.Uuid
  // The device that wrote a conflicted copy's body, for its label (§6.4).
  conflictDevice    String?   @map("conflict_device")
  // The moment in the lesson's source, stamped by capture mode, or a page in a book (§17.7).
  sourceAt          DateTime? @map("source_at") @db.Timestamptz(3)
  sourcePage        String?   @map("source_page")
  // private | group; groupId exactly when group (§17.12). A group, not a foreign key: a section
  // stays the author's whatever happens to the group. sharedAt orders the group thread.
  visibility        String    @default("private")
  groupId           String?   @map("group_id") @db.Uuid
  sharedAt          DateTime? @map("shared_at") @db.Timestamptz(3)
  // Another member's group section this replies to, and the group question it answers (partial
  // | full): other users' rows, so no foreign keys.
  replyToId         String?   @map("reply_to_id") @db.Uuid
  answersQuestionId String?   @map("answers_question_id") @db.Uuid
  answerKind        String?   @map("answer_kind")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev               BigInt    @default(0)
  // Server only: the rev that last changed body, so a push can tell whether the body changed
  // after its baseRev (§6.4).
  bodyRev           BigInt    @default(0) @map("body_rev")
  // Server only: the device that last changed body, which names a conflicted copy made from it.
  bodyDevice        String?   @map("body_device")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent             Section?        @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           Section[]       @relation("SectionTree")
  conflictSource     Section?        @relation("ConflictCopies", fields: [conflictOf], references: [id], onDelete: SetNull)
  conflictCopies     Section[]       @relation("ConflictCopies")
  tags               SectionTag[]
  answeredQuestions  Question[]
  promotedHighlights Highlight[]
  placedInboxItems   InboxItem[]
  questionEntries    QuestionEntry[]
  links              Link[]

  @@index([userId, rev])
  @@index([lessonId, parentId, orderKey])
  @@index([groupId])
  @@map("section")
}

// name is citext; unique per user among non-deleted rows (partial index in SQL)
model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.Citext
  isSeeded  Boolean   @default(false) @map("is_seeded")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections   SectionTag[]
  lessons    LessonTag[]
  inboxItems InboxItemTag[]

  @@index([userId, rev])
  @@map("tag")
}

model SectionTag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  sectionId String    @map("section_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([tagId])
  @@map("section_tag")
}

model LessonTag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  lessonId  String    @map("lesson_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([tagId])
  @@map("lesson_tag")
}

model Takeaway {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  lessonId  String    @map("lesson_id") @db.Uuid
  text      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([lessonId])
  @@map("takeaway")
}

// status: open | answered | parked
// status and answerSectionId left the wire format in M10 (its entries hold them, §17.5); they
// stay, unwritten, for one release so a rollback still works, and the next release drops them.
model Question {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  text            String
  status          String    @default("open")
  answerSectionId String?   @map("answer_section_id") @db.Uuid
  splitFromId     String?   @map("split_from_id") @db.Uuid
  // private | group, as a section's (§17.12)
  visibility      String    @default("private")
  groupId         String?   @map("group_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev             BigInt    @default(0)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answerSection Section?        @relation(fields: [answerSectionId], references: [id], onDelete: SetNull)
  splitFrom     Question?       @relation("QuestionSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits        Question[]      @relation("QuestionSplit")
  entries       QuestionEntry[]

  @@index([userId, rev])
  @@index([lessonId])
  @@index([groupId])
  @@map("question")
}

// One thing that happened to a question, in a lesson (TECH-DESIGN §17.5); its status follows the
// latest. kind: asked | revisited | partial | answered | reopened | parked.
model QuestionEntry {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  lessonId   String    @map("lesson_id") @db.Uuid
  kind       String
  sectionId  String?   @map("section_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev        BigInt    @default(0)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  section  Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([userId, rev])
  @@index([questionId])
  @@map("question_entry")
}

// ref: VerseRef; colour: yellow | green | blue | pink
model Highlight {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ref               Json
  colour            String
  note              String?
  promotedSectionId String?   @map("promoted_section_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev               BigInt    @default(0)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotedSection Section? @relation(fields: [promotedSectionId], references: [id], onDelete: SetNull)

  @@index([userId, rev])
  @@map("highlight")
}

// ref: VerseRef; SM-2 state (domain srs.ts)
model MemoryItem {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  ref          Json
  ease         Float     @default(2.5)
  interval     Int       @default(0)
  nextReviewAt DateTime  @default(now()) @map("next_review_at") @db.Timestamptz(3)
  reviewCount  Int       @default(0) @map("review_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev          BigInt    @default(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([userId, nextReviewAt])
  @@map("memory_item")
}

// A verse or a note waiting to be put in a lesson (TECH-DESIGN §17.2). Not cited until placed.
// origin: share | paste | typed | import | capture; ref: VerseRef; colour: yellow | green | blue |
// pink. A CHECK requires ref or text.
model InboxItem {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  origin            String
  ref               Json?
  text              String?
  sourceUrl         String?   @map("source_url")
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(3)
  colour            String?
  importId          String?   @map("import_id") @db.Uuid
  snoozedUntil      DateTime? @map("snoozed_until") @db.Date
  placedInSectionId String?   @map("placed_in_section_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev               BigInt    @default(0)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  placedInSection Section?       @relation(fields: [placedInSectionId], references: [id], onDelete: SetNull)
  tags            InboxItemTag[]

  @@index([userId, rev])
  @@map("inbox_item")
}

// A tag on an inbox item (F27, §17.2), one live link per item and tag like SectionTag. Placing
// the item moves its tags onto the section.
model InboxItemTag {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid
  inboxItemId String    @map("inbox_item_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev         BigInt    @default(0)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  inboxItem InboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([tagId])
  @@index([inboxItemId])
  @@map("inbox_item_tag")
}

// Derived from the source row on every write and never pushed by the client.
// sourceType: lesson | section | highlight | memory_item. sourceId has no foreign key (it points
// at whichever table sourceType names); the rows are rebuilt with their source.
model Citation {
  id         String  @id @default(uuid(7)) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  sourceType String  @map("source_type")
  sourceId   String  @map("source_id") @db.Uuid
  lessonId   String? @map("lesson_id") @db.Uuid
  book       String
  startOrd   Int     @map("start_ord")
  endOrd     Int     @map("end_ord")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, startOrd, endOrd])
  @@index([sourceType, sourceId])
  @@map("citation")
}

// One of the user's own study-method templates (F25, §17.6); the built-ins are code. structure:
// 1–30 { title, children? }, children one level deep, checked by the app's schema.
model Template {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  structure Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@map("template")
}

// A visit to a compile view (F30, §17.8): its scope as ordinals, and when (createdAt). Never
// edited: a new visit deletes the scope's older ones, so two devices' visits both stand.
model PassageVisit {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  book      String
  startOrd  Int       @map("start_ord")
  endOrd    Int       @map("end_ord")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@index([userId, startOrd, endOrd])
  @@map("passage_visit")
}

// A resurfaced item dismissed for a year (F30, §17.8). rule: year_ago | repeated_verse |
// stale_question. targetKey is a lesson or question id, or a passage slug, with no foreign key.
// Never edited; for a target, the latest until wins.
model ResurfaceDismissal {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  rule      String
  targetKey String    @map("target_key")
  until     DateTime  @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  rev       BigInt    @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rev])
  @@map("resurface_dismissal")
}

// Derived from a section's link chips on every write, like Citation, and never pushed (§17.4).
// targetType: lesson | section. targetId has no foreign key: a link can be broken.
model Link {
  id            String @id @default(uuid(7)) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  fromSectionId String @map("from_section_id") @db.Uuid
  fromLessonId  String @map("from_lesson_id") @db.Uuid
  targetType    String @map("target_type")
  targetId      String @map("target_id") @db.Uuid

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromSection Section @relation(fields: [fromSectionId], references: [id], onDelete: Cascade)
  fromLesson  Lesson  @relation(fields: [fromLessonId], references: [id], onDelete: Cascade)

  @@index([userId, targetId])
  @@index([fromSectionId])
  @@map("link")
}

// One row per pushed change (id = changeId), so a replayed change returns its stored result.
// status: applied | conflict | rejected. deviceId has no foreign key: removing a device must not
// forget which changes were already applied. A conflict keeps its resolution (CONFLICT_RESOLUTIONS
// in domain) and, for a conflicted copy, the copy's id; a rejection keeps its error.
model SyncChange {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  status     String
  error      Json?
  resultRev  BigInt?  @map("result_rev")
  resolution String?
  copyId     String?  @map("copy_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@map("sync_change")
}

// The id is the device's own (syncState.deviceId). A device can sync with more than one account
// over its life (§6.6), so the key is (userId, id).
model Device {
  id            String    @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  clientVersion String    @map("client_version")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@map("device")
}
