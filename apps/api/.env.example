# Copy to .env.local for development. Every variable is checked at startup (src/config/env.ts).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Written by scripts/dev-db.sh (lamp_dev locally; .env.test gets lamp_test_dev and lamp_e2e_dev)
DATABASE_URL=postgresql://lamp:lamp@127.0.0.1:5432/lamp_dev
