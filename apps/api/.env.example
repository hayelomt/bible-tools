# Copy to .env.local for development. Every variable is checked at startup (src/config/env.ts).
# Convention over configuration: only real deployment choices are variables. Outside production,
# emails are written to tmp/emails as .eml files, and the session cookie is Secure except under
# `pnpm dev`.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Written by scripts/dev-db.sh (lamp_dev locally; .env.test gets lamp_test_dev and lamp_e2e_dev)
DATABASE_URL=postgresql://lamp:lamp@127.0.0.1:5432/lamp_dev
# false turns off sign-up (accounts then come from the admin CLI)
SIGNUP_ENABLED=true

# Production only (all required there):
# APP_URL=https://lamp.example        links in emails and share links; emails come from noreply@<its host>
# RESEND_API_KEY=re_…                 sends the emails through Resend
# SHARE_LINK_SECRET=…                 32+ random characters (openssl rand -base64 32); share links'
#                                     addresses are made from it, so changing it turns them all off

# Optional anywhere: errors and a fifth of requests' traces go to Sentry (nothing is sent unset).
# Request bodies, cookies and auth headers are removed first (src/common/sentry-scrub.ts).
# SENTRY_DSN=https://…@….ingest.sentry.io/…
