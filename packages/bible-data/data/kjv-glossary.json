{
  "source": "Curated from W. A. Wright, The Bible Word-Book (2nd ed., 1884; public domain), with modern definitions",
  "_rules": "trigger is a case-sensitive regex; a rule shows its note once when the trigger matches anywhere on the page",
  "rules": [
    {
      "id": "eth",
      "trigger": "\\b(?!teeth\\b)[a-z]{2,}eth\\b",
      "title": "-eth endings",
      "meaning": "An old verb ending for he, she or it: goeth = goes, saith = says, hath = has, doth = does."
    },
    {
      "id": "est",
      "trigger": "\\b[Tt]hou\\b",
      "title": "-est and -st endings",
      "meaning": "An old verb ending used with thou: thou knowest = you know, thou art = you are, thou hast = you have, thou didst = you did."
    },
    {
      "id": "thou-ye",
      "trigger": "\\b(?:[Tt]hou|[Tt]hee|[Tt]hy|[Tt]hine|[Yy]e)\\b",
      "title": "thou, thee, ye",
      "meaning": "Thou, thee, thy and thine address one person; ye and you address more than one. The KJV keeps this difference, which modern English has lost: in Luke 22:31-32 Satan desired to have “you” (all the disciples), but Jesus prayed for “thee” (Peter)."
    }
  ],
