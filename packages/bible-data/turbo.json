{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The downloaded source is gitignored, so it is not in the default inputs. Its checksum stamp
    // is: a run without the source (tests skipped) never serves a run with it from cache.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "source/*/.sha256"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "source/*/.sha256"]
    }
  }
}
