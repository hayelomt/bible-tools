{
  "name": "lamp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "preinstall": "sh scripts/check-node.sh",
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "db:migrate": "pnpm --filter @lamp/api db:migrate",
    "db:seed": "pnpm --filter @lamp/api db:seed",
    "cli": "pnpm --filter @lamp/api cli",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@lamp/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
